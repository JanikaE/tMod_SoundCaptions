Configs: {
	CaptionLayoutConfig: {
		DisplayName: Caption Layout

		HorizontalPosition: {
			Label: Horizontal Position
			Tooltip: 0 is the left edge and 1 is the right edge of the available area.
		}

		VerticalPosition: {
			Label: Vertical Position
			Tooltip: 0 is the top edge and 1 is the bottom edge of the available area.
		}

		WindowWidth: {
			Label: Window Width (UI Units)
			Tooltip: ""
		}

		WindowHeight: {
			Label: Window Height (UI Units)
			Tooltip: ""
		}
	}

	ClientConfig: {
		MusicVolumes: {
			Label: Adjusted Volumes
			Tooltip: ""
		}

		DisplayName: Caption Settings

		Headers: {
			Volume: Adjusted Volumes
			Sound: Sound Effects
			Music: Music
			Development: Development
		}

		ShowSoundCaptions: {
			Label: Show Sound Effect Captions
			Tooltip: ""
		}

		SoundDurationSeconds: {
			Label: Sound Caption Duration (Seconds)
			Tooltip: ""
		}

		SoundTextColor: {
			Label: Sound Caption Text Color
			Tooltip: ""
		}

		SoundBackgroundColor: {
			Label: Sound Caption Background Color
			Tooltip: ""
		}

		SoundBackgroundOpacity: {
			Label: Sound Caption Background Opacity (%)
			Tooltip: ""
		}

		SoundTextScale: {
			Label: Sound Caption Text Scale (%)
			Tooltip: ""
		}

		DirectionThreshold: {
			Label: Direction Threshold (World Pixels)
			Tooltip: Hide the arrow when the horizontal distance is at or below this value.
		}

		ShowMusicCaptions: {
			Label: Show Music Captions
			Tooltip: ""
		}

		MusicMode: {
			Label: Music Caption Mode
			Tooltip: ""
		}

		MusicDurationSeconds: {
			Label: Track Change Caption Duration (Seconds)
			Tooltip: ""
		}

		MusicTextColor: {
			Label: Music Caption Text Color
			Tooltip: ""
		}

		MusicBackgroundColor: {
			Label: Music Caption Background Color
			Tooltip: ""
		}

		MusicBackgroundOpacity: {
			Label: Music Caption Background Opacity (%)
			Tooltip: ""
		}

		MusicTextScale: {
			Label: Music Caption Text Scale (%)
			Tooltip: ""
		}

		EnableDiagnostics: {
			Label: Enable Diagnostics
			Tooltip: Show sound playback diagnostics and enable /soundcaptionsdiag probes in chat.
		}
	}

	MusicDisplayMode: {
		OnTrackChange: {
			Label: Only When the Track Changes
			Tooltip: ""
		}

		Always: {
			Label: Always Show the Current Track
			Tooltip: ""
		}

		Tooltip: ""
	}
}

