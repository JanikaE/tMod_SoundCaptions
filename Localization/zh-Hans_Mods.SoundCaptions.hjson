Configs: {
	CaptionLayoutConfig: {
		DisplayName: 字幕布局

		HorizontalPosition: {
			Label: 水平位置
			Tooltip: 0 靠左，1 靠右。位置随可用区域变化。
		}

		VerticalPosition: {
			Label: 垂直位置
			Tooltip: 0 靠上，1 靠下。位置随可用区域变化。
		}

		WindowWidth: {
			Label: 窗口宽度（UI 单位）
			// Tooltip: ""
		}

		WindowHeight: {
			Label: 窗口高度（UI 单位）
			// Tooltip: ""
		}
	}

	ClientConfig: {
		MusicVolumes: {
			Label: 已调整音量
			// Tooltip: ""
		}

		DisplayName: 字幕设置

		Headers: {
			Volume: 已调整音量
			Sound: 音效
			Music: 音乐
			Development: 开发
		}

		ShowSoundCaptions: {
			Label: 显示音效字幕
			// Tooltip: ""
		}

		SoundDurationSeconds: {
			Label: 音效字幕停留时间（秒）
			// Tooltip: ""
		}

		SoundTextColor: {
			Label: 音效字幕字色
			// Tooltip: ""
		}

		SoundBackgroundColor: {
			Label: 音效字幕背景色
			// Tooltip: ""
		}

		SoundBackgroundOpacity: {
			Label: 音效字幕背景不透明度（%）
			// Tooltip: ""
		}

		SoundTextScale: {
			Label: 音效字幕字号（%）
			// Tooltip: ""
		}

		DirectionThreshold: {
			Label: 无方向阈值（世界像素）
			Tooltip: 声源与玩家的横向距离不超过此值时，隐藏方向箭头。
		}

		ShowMusicCaptions: {
			Label: 显示音乐字幕
			// Tooltip: ""
		}

		MusicMode: {
			Label: 音乐字幕模式
			// Tooltip: ""
		}

		MusicDurationSeconds: {
			Label: 切曲字幕停留时间（秒）
			// Tooltip: ""
		}

		MusicTextColor: {
			Label: 音乐字幕字色
			// Tooltip: ""
		}

		MusicBackgroundColor: {
			Label: 音乐字幕背景色
			// Tooltip: ""
		}

		MusicBackgroundOpacity: {
			Label: 音乐字幕背景不透明度（%）
			// Tooltip: ""
		}

		MusicTextScale: {
			Label: 音乐字幕字号（%）
			// Tooltip: ""
		}

		EnableDiagnostics: {
			Label: 启用诊断
			Tooltip: 显示音效播放诊断，并启用聊天命令 /soundcaptionsdiag 的探针。
		}
	}

	MusicDisplayMode: {
		OnTrackChange: {
			Label: 仅切曲时显示
			// Tooltip: ""
		}

		Always: {
			Label: 持续显示当前曲目
			// Tooltip: ""
		}

		// Tooltip: ""
	}
}

Keybinds.ToggleEditMode.DisplayName: 切换字幕编辑模式

Diagnostics: {
	StressAlreadyRunning: 已有一轮字幕测量正在运行。
	StressNeedsWorld: 请先进入世界再开始测量。
	StressBaselineStarted: "已开始字幕基线测量（{0} 秒）。"
	StressLoadStarted: "已开始字幕压力测量（{0} 秒）。"
	StressIdle: 当前没有字幕测量。
	StressBaseline: 基线
	StressLoad: 压力
	StressReport: "{0} · {1:F1} 秒 · {2} 次更新 · 平均间隔 {3:F2} ms，最大 {4:F2} ms · 托管堆 {5:F1} → {6:F1} MiB · 活动字幕峰值 {7}"
	Description: 检查 Sound Captions 的客户端状态。
	Disabled: Sound Captions 诊断已关闭，可在字幕设置中启用。
	KeybindReady: Sound Captions 客户端已加载，编辑模式快捷键已注册。
	KeybindUnavailable: Sound Captions 客户端已加载，编辑模式快捷键不可用。
	AudioAvailable: 游戏音频可用，音效总音量为 {0:P0}。
	AudioUnavailable: 游戏音频引擎不可用。
	Cleared: 已清空 Sound Captions 诊断计数。
	Counts: Sound Captions | 已接受 {0} | 播放阶段拒绝 {1}
	NameCounts: 命名 {0} · 回退 {1}
	LastAccepted: 最近接受：{0} | 坐标：{1}
	LastRejected: 最近在播放阶段被拒绝：{0}
	Identity: 字幕键：{0} | 音量目标：{1}
	Output: 初始输出：{0:P0} | 声像：{1:0.00} | 音高：{2:0.00}
	NoPosition: 全局（无坐标）
	ProbeResult: 探针：{0} | 接受 +{1} | 播放阶段拒绝 +{2} | 请求坐标：{3}
	ValidSlot: 有效句柄
	InvalidSlot: 无效句柄
	NoAudio: 音频不可用
	MusicStatus: 音乐：{0} | 选曲变化：{1} | Cue 淡化：{2:P0} | 流式淡化：{3:P0}
	NoTrack: 无曲目
	SelectedProbe: 音乐选择探针：{0}
	GainSet: 已将 {0} 的测试音量设为 {1:P0}。
	ProbeUnavailable: 测试样例或其音量输出挂钩不可用。
	LoopStarted: 已启动测试循环音效。
	LoopStopped: 测试循环音效已停止。
	LoopOutput: 循环音效设置：{0:P0} | 当前输出：{1:P0}
	LoopPairOutput: 左侧声像：{0:0.00} | 右侧输出：{1:P0} | 右侧声像：{2:0.00}
	CaptionCount: 有效音效字幕：{0}
	CaptionBatch: 已生成 {0} 类测试字幕。有效音效字幕：{1}
	CaptionsDisabled: 请先在字幕设置中开启音效字幕。
}

