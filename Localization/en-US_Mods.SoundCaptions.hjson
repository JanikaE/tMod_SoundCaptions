Diagnostics: {
	StressAlreadyRunning: A caption measurement is already running.
	StressNeedsWorld: Enter a world before starting a caption measurement.
	StressBaselineStarted: Caption baseline started ({0} seconds).
	StressLoadStarted: Caption stress test started ({0} seconds).
	StressIdle: No caption measurement is running.
	StressBaseline: Baseline
	StressLoad: Stress
	StressReport: "{0} · {1:F1} s · {2} updates · interval avg {3:F2} ms, max {4:F2} ms · managed heap {5:F1} → {6:F1} MiB · peak captions {7}"
	Description: Check Sound Captions client status.
	Disabled: Sound Captions diagnostics are off. Enable them in Caption Settings.
	KeybindReady: Sound Captions client loaded. The edit mode keybind is registered.
	KeybindUnavailable: Sound Captions client loaded. The edit mode keybind is unavailable.
	AudioAvailable: Audio available. Game sound volume: {0:P0}
	AudioUnavailable: The game audio engine is unavailable.
	Cleared: Sound Captions diagnostic counters cleared.
	Counts: Sound Captions | Accepted: {0} | Rejected at playback: {1}
	NameCounts: Named {0} · fallback {1}
	LastAccepted: Last accepted: {0} | Position: {1}
	LastRejected: Last rejected at playback: {0}
	Identity: Caption: {0} | Volume target: {1}
	Output: Initial output: {0:P0} | Pan: {1:0.00} | Pitch: {2:0.00}
	NoPosition: Global (no position)
	ProbeResult: Probe: {0} | Accepted +{1} | Rejected at playback +{2} | Requested position: {3}
	ValidSlot: Valid slot
	InvalidSlot: Invalid slot
	NoAudio: Audio unavailable
	MusicStatus: Music: {0} | Selection changes: {1} | Cue fade: {2:P0} | Stream fade: {3:P0}
	NoTrack: No track
	SelectedProbe: Music selection probe: {0}
	GainSet: Diagnostic gain for {0}: {1:P0}
	ProbeUnavailable: The sample or its output hook is unavailable.
	LoopStarted: Diagnostic sound loop started.
	LoopStopped: Diagnostic sound loop is stopped.
	LoopOutput: Loop gain: {0:P0} | Current output: {1:P0}
	LoopPairOutput: Left pan: {0:0.00} | Right output: {1:P0} | Right pan: {2:0.00}
	CaptionCount: Active sound captions: {0}
	CaptionBatch: Generated {0} distinct test captions. Active sound captions: {1}
	CaptionsDisabled: Enable sound effect captions in Caption Settings to run this probe.
}

